## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Xx]64/
[Xx]86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Vv]logs/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you use Visual Studio Code
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-agent.log

# Build logs
*.log

# StyleCop
StyleCopReport.xml

# Files built by Visual Studio
*.info
*.obj
*.pdb
*.lib
*.exp
*.exe
*.xdc
*.pdb
*.ilk
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile
*.nosync
*.VC.db
*.VC.VC.opendb

# Visual Studio 2015/2017 analyzer result caching
*.axd
*.targets

# Azure Cloud Service project settings
*.cscfg
*.csdef

# Amazon Web Services SDK for .NET settings
App.config

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# AspNet5 internal files
bin/
obj/

# Visual Studio Code tasks
.vscode/tasks.json
.vscode/launch.json
.vscode/extensions.json

# Rider
.idea/

# macOS
.DS_Store
